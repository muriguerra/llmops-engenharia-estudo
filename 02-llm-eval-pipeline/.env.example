# 1. Conexao com o PostgreSQL + pgvector (herdado do Desafio 01)
POSTGRES_USER=unicamp_user
POSTGRES_PASSWORD=unicamp_pass
POSTGRES_DB=unicamp_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 2. Configuracao do Provedor LLM (Gerador e LLM-as-a-Judge)
# Opcoes suportadas:
#   - "antigravity" (Execucao assistida/subagentes sem necessidade de chave de API externa)
#   - "gemini"      (Google AI Studio API - requer GEMINI_API_KEY)
#   - "openai"      (OpenAI API - requer OPENAI_API_KEY)
LLM_PROVIDER=antigravity
LLM_MODEL_GENERATOR=gemini-2.5-flash
LLM_MODEL_JUDGE=gemini-2.5-flash

# Preencha apenas caso altere LLM_PROVIDER para "gemini" ou "openai":
GEMINI_API_KEY=sua_chave_aqui
OPENAI_API_KEY=sua_chave_aqui
